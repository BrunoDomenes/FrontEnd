# Provedor padrão: anthropic | ollama
PROVIDER=ollama
SERVICE_API_KEY=troque-por-uma-chave-forte
MAX_UPLOAD_MB=20

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# --- Ollama (local) ---
# Rodando direto na máquina: http://localhost:11434
# API em Docker + Ollama no host: http://host.docker.internal:11434
# Com docker-compose deste projeto: http://ollama:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT=600
